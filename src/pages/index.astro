---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageEntries = await getCollection("site");
const home = pageEntries[0];

if (!home) {
    throw new Error("Missing content entry: src/content/site/home.mdx");
}

const heroName = ["DEVIN", "BARON"];
const heroSubtitle = "CREATIVE SERVICES";
// Deferred idea: small Athletics-gold location pin with  "Pensacola, FL"
// beneath the "C" in CREATIVE SERVICES, styled in Syne Mono.
const services = [
    "Album Covers",
    "Asset Organization And Cleanup",
    "Banners",
    "Beach Photography",
    "Blog Posts",
    "Brochures",
    "Business Cards",
    "Campaign Concepts",
    "Caption Writing",
    "Company Calendars",
    "Company Conference Planning And Coordination",
    "Company PowerPoints",
    "Copywriting",
    "Creative Brainstorm Sessions",
    "Creative Consulting",
    "Creative Direction",
    "Dating Profile Photos",
    "Email Newsletters",
    "Event Branding",
    "Event Coordination",
    "Event Emceeing",
    "Event Flyers",
    "Event Photography",
    "Event Promotion",
    "Event Recap Videos",
    "Event Videography",
    "Family Photos",
    "Flyers",
    "Graduation Photos",
    "Guest Experience Planning",
    "Headshots",
    "Infographics",
    "Internal Communications Materials",
    "Lifestyle Photos",
    "Local Advertisements",
    "Logo Design",
    "Magazines",
    "Marketing Strategy",
    "Memes",
    "Menu Design",
    "Newspaper Articles",
    "Personal Brand Setup",
    "Pitch Decks",
    "Portraits",
    "Posters",
    "Press Releases",
    "Print Ordering And Setup",
    "Product Photography",
    "Profile Optimization",
    "Programs",
    "Promotional Videos",
    "Real Estate Photography",
    "Rebranding",
    "Short Films",
    "Signs",
    "Slogan And Tagline Writing",
    "Social Media Ads",
    "Social Media Help",
    "Social Media Launch Setup",
    "Social Media Posts",
    "Social Media Templates",
    "Staff Photos",
    "Stickers And Magnets",
    "Studio Photography",
    "Testimonials",
    "Thumbnail Design",
    "TikToks And Reels",
    "Vendor Coordination",
    "Vehicle Photography",
    "Wedding Photos",
    "Wedding Video",
    "Website Creation",
    "Website Design",
    "Website Help",
    "Website Updates",
    "YouTube Channel Setup",
];
const sortedServices = [...services].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title={home.data.title} description={home.data.description}>
    <main class="site-shell" id="top">
        <section class="hero">
            <div class="hero-name">
                <h1 class="hero-title">
                    {
                        heroName.map((word) => (
                            <span class="hero-word hero-word-title">
                                {word.split("").map((letter) => (
                                    <span class="hero-letter hero-letter-title">
                                        {letter}
                                    </span>
                                ))}
                            </span>
                        ))
                    }
                </h1>

                <p class="hero-subtitle" aria-label="Creative Services">
                    <span class="hero-word hero-word-subtitle">
                        {
                            heroSubtitle.split("").map((letter) => (
                                <span
                                    class:list={[
                                        "hero-letter",
                                        "hero-letter-subtitle",
                                        { "hero-space": letter === " " },
                                    ]}
                                    aria-hidden={
                                        letter === " " ? "true" : undefined
                                    }
                                >
                                    {letter === " " ? "" : letter}
                                </span>
                            ))
                        }
                    </span>
                </p>

                <p class="hero-message">
                    Whatever creative or marketing thing you need done, let's
                    knock it out. And let's not complicate it.
                    <br />
                    <br />
                    A La Carte Menu below.
                </p>
            </div>

            <div class="hero-portrait">
                <div class="portrait-card">
                    <span class="portrait-tape" aria-hidden="true"></span>
                    <div class="portrait-note" aria-hidden="true">
                        <span class="portrait-note-text">I'm<br />Devin</span>
                        <svg
                            class="portrait-note-arrow"
                            viewBox="0 0 220 150"
                            role="presentation"
                        >
                            <defs>
                                <marker
                                    id="portrait-note-arrowhead"
                                    markerWidth="14"
                                    markerHeight="14"
                                    refX="10"
                                    refY="7"
                                    orient="auto-start-reverse"
                                    markerUnits="userSpaceOnUse"
                                >
                                    <path d="M1 1 L11 7 L1 13"></path>
                                </marker>
                            </defs>
                            <path
                                class="portrait-note-arrow-main"
                                d="M182 36 C159 34, 136 40, 113 52 C88 65, 66 84, 46 105"
                                marker-end="url(#portrait-note-arrowhead)"
                            ></path>
                        </svg>
                    </div>
                    <div class="portrait-frame">
                        <img
                            src="/images/devin-portrait.jpg"
                            alt={home.data.portraitAlt}
                            width="720"
                            height="900"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section
            class="services-listing"
            aria-labelledby="services-listing-title"
        >
            <div class="services-listing-heading">
                <h2 class="services-listing-title" id="services-listing-title">
                    A La Carte Services
                </h2>
                <p class="services-listing-subtitle">
                    Pick What You Want. Leave the Rest.
                </p>
            </div>
            <ul class="services-list" role="list">
                {sortedServices.map((service) => <li>{service}</li>)}
            </ul>
            <p class="services-listing-note">
                *Samples are available upon request
            </p>
            <p class="services-listing-cta">
                <span class="services-listing-contact">
                    <span class="services-listing-cta-line"
                        ><span class="services-listing-copy-white"
                            >Call me at
                        </span><span class="services-listing-contact-accent"
                            >251-424-3452</span
                        ></span
                    >
                    <span class="services-listing-cta-line"
                        ><span class="services-listing-copy-white"
                            >or Email me at
                        </span><span class="services-listing-contact-accent"
                            >barondevin33@gmail.com</span
                        ></span
                    >
                </span>
                <span
                    class="services-listing-cta-line services-listing-copy-white"
                    >Let's talk (and we can even get started) today!</span
                >
            </p>
        </section>
    </main>
</BaseLayout>

<style>
    .site-shell {
        position: relative;
        z-index: 1;
        width: min(980px, calc(100% - 3rem));
        margin: 0 auto;
        padding: 2.5rem 0 5rem;
    }

    .hero {
        position: relative;
        z-index: 1;
    }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 0.88fr) minmax(320px, 1fr);
        gap: 2.2rem;
        align-items: start;
        max-width: 62rem;
        margin: 0 auto;
        padding: 1.75rem 0 1.6rem;
    }

    .services-listing {
        margin: 2.9rem auto 0;
        padding-top: 1.48rem;
    }

    .services-listing-heading {
        width: fit-content;
        max-width: 100%;
        margin: 0 0 1.5rem;
    }

    .services-listing-title {
        margin: 0;
        font-family: "Syne Mono", monospace;
        width: fit-content;
        max-width: none;
        font-size: clamp(2.3rem, 4.15vw, 3.6rem);
        font-weight: 400;
        line-height: 0.95;
        color: var(--yellow);
        text-align: left;
        white-space: nowrap;
    }

    .services-listing-subtitle {
        display: block;
        width: fit-content;
        margin: -0.18rem 0 0;
        font-family: "Syne Mono", monospace;
        font-size: clamp(0.96rem, 1.6vw, 1.38rem);
        font-weight: 400;
        line-height: 1.05;
        color: var(--cream);
        text-align: left;
        white-space: nowrap;
    }

    .services-list {
        column-count: 4;
        column-gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .services-list li {
        break-inside: avoid;
        margin: 0 0 0.7rem;
        font-family: "Syne Mono", monospace;
        font-size: 1rem;
        line-height: 1.35;
        text-wrap: balance;
    }

    .services-listing-note {
        margin: 1.2rem 0 0;
        font-family: "Syne Mono", monospace !important;
        font-size: 0.88rem;
        font-weight: 400;
        letter-spacing: 0;
        font-style: normal;
        line-height: 1.35;
        text-align: center;
        color: var(--cream);
    }

    .services-listing-cta {
        margin: 1.78rem 0 0;
        font-family: "Syne Mono", monospace !important;
        font-size: clamp(1.34rem, 2.3vw, 1.95rem);
        line-height: 1.62;
        letter-spacing: 0.01em;
        color: var(--cream) !important;
        text-wrap: balance;
    }

    .services-listing-contact {
        display: block;
        margin-top: 0;
        font-size: inherit;
        line-height: 1.28;
    }

    .services-listing-cta-line {
        display: block;
        line-height: 1.28;
    }

    .services-listing-copy-white {
        color: var(--cream) !important;
    }

    .services-listing-contact-accent {
        color: var(--yellow) !important;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .hero-name {
        display: grid;
        justify-items: start;
        gap: 0.52rem;
        padding-top: 6.25rem;
        position: relative;
        z-index: 5;
        margin-left: -1.75rem;
    }

    .hero-title {
        display: flex;
        align-items: flex-start;
        flex-wrap: nowrap;
        gap: 0.64rem;
        margin: 0;
        white-space: nowrap;
    }

    .hero-word {
        display: flex;
        flex-wrap: nowrap;
    }

    .hero-word-title {
        gap: 0;
    }

    .hero-word-subtitle {
        width: 100%;
        justify-content: space-between;
        gap: 0;
    }

    .hero-letter {
        position: relative;
        display: inline-flex;
        align-items: flex-start;
        justify-content: center;
        background: #101010;
        color: #f8f4eb;
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset;
        overflow: visible;
        text-transform: uppercase;
    }

    .hero-letter::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: #101010;
        transform: translateX(-0.09rem);
    }

    .hero-letter-title {
        min-width: clamp(3.1rem, 4.8vw, 4.4rem);
        height: clamp(4rem, 6.2vw, 5.7rem);
        padding: 0.14rem 0.26rem 0.1rem;
        margin-left: -0.02rem;
        border-radius: 1.12rem;
        font-family: var(--font-display);
        font-size: clamp(2.6rem, 4.45vw, 4.1rem);
        font-weight: 400;
        line-height: 0.96;
        letter-spacing: 0.035em;
    }

    .hero-subtitle {
        display: flex;
        align-items: flex-start;
        width: clamp(24rem, 42vw, 31rem);
        max-width: 100%;
        margin: 0.22rem 0 0 0.12rem;
        white-space: nowrap;
    }

    .hero-message {
        width: clamp(21.4rem, 36vw, 25.5rem);
        max-width: 100%;
        margin: 4.1rem 0 0 0.15rem;
        font-family: "Syne Mono", monospace;
        font-size: clamp(1.08rem, 1.82vw, 1.52rem);
        line-height: 1.48;
        color: var(--cream);
        text-wrap: balance;
    }

    .hero-letter-subtitle {
        min-width: auto;
        height: auto;
        padding: 0;
        margin-left: 0;
        background: transparent;
        box-shadow: none;
        border-radius: 0;
        font-family: var(--font-hero-subtitle-current);
        font-size: clamp(1.35rem, 1.9vw, 1.75rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0;
        text-transform: none;
    }

    .hero-letter-subtitle::before {
        content: none;
    }

    .hero-space {
        width: auto;
        flex: 0 0 auto;
    }

    .hero-portrait {
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

    .portrait-card {
        position: relative;
        width: min(29.5rem, 100%);
        padding-top: 1rem;
    }

    .portrait-tape {
        position: absolute;
        top: clamp(-3.35rem, -5.5vw, -2.6rem);
        left: 50%;
        z-index: 3;
        width: clamp(13.8rem, 34vw, 16.8rem);
        aspect-ratio: 781 / 304;
        background: url("/images/taylor-tape-reference.png") center / 100% 100%
            no-repeat;
        transform: translateX(-50%) rotate(-2.8deg);
        filter: contrast(1.03);
        pointer-events: none;
    }

    .portrait-note {
        position: absolute;
        top: -0.45rem;
        right: calc(-13.6rem - 16px);
        z-index: 4;
        display: grid;
        justify-items: start;
        gap: 0.15rem;
        color: var(--yellow);
        transform: rotate(-4deg);
        pointer-events: none;
    }

    .portrait-note-text {
        font-family: "Permanent Marker", var(--font-script);
        font-size: clamp(1.35rem, 1.95vw, 1.8rem);
        line-height: 0.88;
        letter-spacing: 0.01em;
        white-space: pre-line;
        transform: translateX(-110px);
    }

    .portrait-note-arrow {
        position: absolute;
        top: calc(100% - 50px);
        left: calc(-240px - 0.35rem);
        width: clamp(7.6rem, 13vw, 9.2rem);
        height: auto;
        overflow: visible;
    }

    .portrait-note-arrow path {
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .portrait-note-arrow-main {
        stroke-width: 4.8;
    }

    .portrait-note-arrow marker path {
        fill: none;
        stroke: currentColor;
        stroke-width: 4.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .portrait-frame {
        overflow: hidden;
        border-radius: 1.2rem;
        background: #ddd8cf;
    }

    .portrait-frame img {
        width: 100%;
        height: auto;
        background: #cfcfcf;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
    }

    @media (max-width: 640px) {
        .site-shell {
            width: min(100% - 1.4rem, 100%);
            padding-top: 1.2rem;
            padding-bottom: 3.5rem;
        }

        .hero {
            grid-template-columns: 1fr;
            gap: 1.8rem;
            padding-top: 2rem;
            padding-bottom: 1rem;
            justify-items: center;
        }

        .services-listing {
            margin-top: 2.4rem;
            padding-top: 1.35rem;
        }

        .services-listing-heading {
            margin-bottom: 1.1rem;
        }

        .services-listing-title {
            margin-bottom: 1.15rem;
            max-width: 100%;
            font-size: clamp(1.78rem, 8.6vw, 2.85rem);
            line-height: 1;
            white-space: nowrap;
        }

        .services-listing-subtitle {
            margin-top: -0.85rem;
            width: 100%;
            font-size: clamp(1.05rem, 4.2vw, 1.45rem);
            line-height: 1.1;
            max-width: 100%;
            white-space: normal;
            color: var(--yellow);
        }

        .hero-name {
            justify-items: center;
            padding-top: 0;
            margin-left: 0;
        }

        .hero-title {
            align-items: center;
            justify-content: center;
            gap: 0.24rem;
            width: 100%;
        }

        .hero-subtitle {
            width: min(100%, 24rem);
            margin-left: 0;
            text-align: center;
        }

        .hero-message {
            width: min(100%, 24rem);
            margin: 1rem 0 0;
            text-align: center;
        }

        .services-list {
            column-count: 1;
        }

        .services-list li {
            font-size: 0.96rem;
            line-height: 1.3;
        }

        .services-listing-note {
            margin-top: 1rem;
            font-size: 0.8rem;
        }

        .services-listing-cta {
            margin-top: 1.35rem;
            font-size: clamp(0.84rem, 3.7vw, 1.02rem);
            line-height: 1.45;
            text-align: center;
            overflow-wrap: normal;
        }

        .services-listing-contact {
            display: block;
        }

        .services-listing-contact .services-listing-cta-line:first-child {
            display: block;
        }

        .services-listing-cta-line {
            line-height: 1.35;
            white-space: nowrap;
        }

        .portrait-tape {
            top: clamp(-1.8rem, -6vw, -1.25rem);
            width: clamp(11.4rem, 55vw, 14rem);
        }

        .portrait-note {
            top: 8.5rem;
            left: 3.9rem;
            right: auto;
            transform: translate(0.4rem, 1.75rem) rotate(3deg) scale(1.44);
            transform-origin: top left;
        }

        .portrait-card {
            padding-top: 2rem;
        }

        .portrait-note-text {
            transform: rotate(-3deg);
            transform-origin: center;
        }

        .portrait-note-arrow {
            top: calc(100% - 6.7rem);
            left: calc(100% + 12.6rem);
            width: clamp(7.1rem, 13.7vw, 9.2rem);
            transform: translateX(-8.25rem) scaleX(-1) rotate(30deg);
            transform-origin: top left;
        }

        .portrait-note-arrow {
            top: calc(100% - 50px);
            left: calc(-240px - 0.35rem);
        }

        .hero-letter-title {
            min-width: clamp(2.05rem, 10vw, 2.7rem);
            height: clamp(2.8rem, 13vw, 3.5rem);
            padding: 0.12rem 0.18rem 0.08rem;
            border-radius: 0.82rem;
            font-size: clamp(1.8rem, 8.5vw, 2.45rem);
            letter-spacing: 0.025em;
        }

        .hero-letter-subtitle {
            font-size: clamp(0.82rem, 3.55vw, 1.02rem);
        }
    }

    @media (max-width: 420px) {
        .site-shell {
            width: min(100% - 1rem, 100%);
        }

        .hero {
            gap: 1.5rem;
            padding-top: 1.7rem;
        }

        .hero-subtitle {
            width: min(100%, 20rem);
        }

        .hero-message {
            width: min(100%, 21rem);
            font-size: clamp(0.96rem, 4.3vw, 1.08rem);
            line-height: 1.42;
        }

        .services-listing-title {
            font-size: clamp(1.62rem, 8.8vw, 2.15rem);
        }

        .services-listing-subtitle {
            font-size: clamp(0.92rem, 4vw, 1.15rem);
        }

        .hero-letter-title {
            min-width: clamp(1.78rem, 9.3vw, 2.3rem);
            height: clamp(2.45rem, 12vw, 3rem);
            font-size: clamp(1.56rem, 7.8vw, 2.05rem);
            border-radius: 0.7rem;
        }

        .hero-letter-subtitle {
            font-size: clamp(0.72rem, 3.45vw, 0.9rem);
        }

        .portrait-note {
            top: 6.55rem;
            left: 2.35rem;
            right: auto;
            transform: translate(0.15rem, 1.42rem) rotate(3deg) scale(1.16);
        }

        .portrait-card {
            padding-top: 1.7rem;
        }

        .portrait-note-arrow {
            top: calc(100% - 5.5rem);
            left: calc(100% + 10.4rem);
            width: clamp(6.2rem, 17.2vw, 7.7rem);
            transform: translateX(-6.3rem) scaleX(-1) rotate(30deg);
        }
    }

    @media (min-width: 641px) and (max-width: 900px) {
        .services-list {
            column-count: 2;
        }
    }
</style>
